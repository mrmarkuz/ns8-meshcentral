{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "local>NethServer/.github:ns8-automerge"
    ],
    "packageRules": [
        {
            "matchDatasources": ["github-release"],
            "matchPackageNames": ["ylianst/meshcentral"],
            "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-mongodb$"
        },
        {
            "matchDatasources": ["docker"],
            "matchPackageNames": ["mongo"],
            "allowedVersions": "7.0.*"
        }
    ]
}
